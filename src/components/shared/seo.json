{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "seo",
    "icon": "search",
    "description": "Search and social sharing. Leave empty to use the title, summary and main image."
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "required": false,
      "minLength": 30,
      "maxLength": 70
    },
    "metaDescription": {
      "type": "text",
      "required": false,
      "minLength": 120,
      "maxLength": 200
    },
    "metaImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "keywords": {
      "type": "text"
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    },
    "canonicalURL": {
      "type": "string"
    }
  }
}
