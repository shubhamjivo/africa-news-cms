{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Home page layout and story picks. Sections: order, headings and visibility. Empty story lists fall back to the newest articles."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "home.section"
    },
    "lead_story": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::article.article"
    },
    "what_matters_today": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "trending": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "missed_it": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "most_read": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "the_brief": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "featured_insight": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::insight.insight"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
