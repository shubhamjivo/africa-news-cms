{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company",
    "description": "An organisation in the Companies directory."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "company_type": {
      "type": "enumeration",
      "enum": [
        "IPP",
        "Developer",
        "Utility",
        "DFI",
        "Investor",
        "OEM",
        "Offtaker",
        "Major",
        "Government"
      ],
      "required": true
    },
    "headquarters": {
      "type": "string"
    },
    "highlight": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "website": {
      "type": "string"
    },
    "is_spotlight": {
      "type": "boolean",
      "default": false
    },
    "spotlight_stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    }
  }
}
