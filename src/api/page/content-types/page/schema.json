{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "A website page, found by its slug (home, news, projects, about, \u2026). Sections hold content with lots of text or picks; headings and links are part of the website design."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.article-list",
        "sections.desk-group",
        "sections.insight-list",
        "sections.text-columns",
        "sections.item-grid",
        "sections.people"
      ]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
